# MySQL-compatible database (TiDB Cloud Serverless, PlanetScale, or local MySQL/MariaDB for dev)
DATABASE_URL="mysql://user:password@host:3306/konvert"
# Set to "false" only for local dev databases that don't speak TLS.
# Hosted providers (TiDB Cloud, PlanetScale) require TLS and will refuse plain connections.
DATABASE_SSL="true"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Storage / push / LLM adapters (swap provider via env, never hardcode a vendor)
STORAGE_PROVIDER="r2"
PUSH_PROVIDER="vapid"
LLM_PROVIDER="openai"

PORT="3000"
